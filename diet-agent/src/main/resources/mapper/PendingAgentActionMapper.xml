<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.diet.mapper.PendingAgentActionMapper">
    <resultMap id="PendingActionMap" type="com.diet.model.PendingAgentActionRow">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="sessionId" column="session_id"/>
        <result property="taskType" column="task_type"/>
        <result property="actionJson" column="action_json"/>
        <result property="previewJson" column="preview_json"/>
        <result property="preconditionHash" column="precondition_hash"/>
        <result property="status" column="status"/>
        <result property="expiresAt" column="expires_at"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>
    <sql id="Columns">id,user_id,session_id,task_type,action_json,preview_json,precondition_hash,status,expires_at,created_at,updated_at</sql>
    <insert id="insert" parameterType="com.diet.model.PendingAgentActionRow">
        INSERT INTO diet_agent_pending_action
        (id,user_id,session_id,task_type,action_json,preview_json,precondition_hash,status,expires_at,created_at,updated_at)
        VALUES
        (#{id},#{userId},#{sessionId},#{taskType},#{actionJson},#{previewJson},#{preconditionHash},#{status},#{expiresAt},NOW(),NOW())
    </insert>
    <select id="findOwned" resultMap="PendingActionMap">
        SELECT <include refid="Columns"/> FROM diet_agent_pending_action
        WHERE id=#{id} AND user_id=#{userId} LIMIT 1
    </select>
    <select id="findLatestPending" resultMap="PendingActionMap">
        SELECT <include refid="Columns"/> FROM diet_agent_pending_action
        WHERE session_id=#{sessionId} AND user_id=#{userId} AND status='PENDING'
        ORDER BY created_at DESC LIMIT 1
    </select>
    <update id="updateStatus">
        UPDATE diet_agent_pending_action SET status=#{status}, updated_at=NOW()
        WHERE id=#{id} AND user_id=#{userId} AND status=#{expectedStatus}
    </update>
    <update id="expireOwned">
        UPDATE diet_agent_pending_action SET status='EXPIRED', updated_at=NOW()
        WHERE id=#{id} AND user_id=#{userId} AND status='PENDING'
    </update>
</mapper>
